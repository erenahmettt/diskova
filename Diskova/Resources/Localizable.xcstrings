          }
        }
      }
    },
    "Pick a folder or a disk. Diskova maps it so the biggest things are the biggest shapes — then you can throw them away from here.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klasör ya da disk seçin. Diskova onu haritaya döker: en çok yer kaplayan en büyük kutu olur — sonra buradan silebilirsiniz."
          }
        }
      }
    },
    "Recent": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
